<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cs4201</groupId>
  <artifactId>java-lucene-ir</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>CS4201 Java Lucene IR — Shuvam Banerji Seal (22MS076)</name>
  <description>
    Java reimplementation of the FIRE 2012 English Ad-hoc retrieval assignment
    using Apache Lucene. Mirrors the Python/PyLucene indexer + retriever:
    BM25(k1=1.5, b=0.4) + EnglishAnalyzer.
  </description>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Lucene version -->
    <lucene.version>9.12.0</lucene.version>
  </properties>

  <dependencies>

    <!-- ===== Apache Lucene Core ===== -->
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-core</artifactId>
      <version>${lucene.version}</version>
    </dependency>

    <!-- ===== Lucene English Analyzer ===== -->
    <!-- Porter stemmer + stopword removal for English text. -->
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-analysis-common</artifactId>
      <version>${lucene.version}</version>
    </dependency>

    <!-- ===== Lucene QueryParser ===== -->
    <!-- Parses free-text queries into Lucene Query objects. -->
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-queryparser</artifactId>
      <version>${lucene.version}</version>
    </dependency>

    <!-- ===== Google Gson ===== -->
    <!-- JSONL parsing. -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.11.0</version>
    </dependency>

  </dependencies>

  <build>
    <plugins>

      <!-- Enforce Java 17 compilation -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <source>17</source>
          <target>17</target>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>

      <!-- Fat JAR: bundles all dependencies so you can run with plain `java -jar` -->
      <!-- IMPORTANT: must use maven-shade-plugin (not assembly) because Lucene uses  -->
      <!-- Java SPI (META-INF/services/) for codec discovery. The assembly plugin     -->
      <!-- overwrites service files; the shade plugin appends them, which is required -->
      <!-- to prevent "Lucene912 PostingsFormat does not exist" at runtime.           -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>false</shadedArtifactAttached>
              <transformers>
                <!-- ServicesResourceTransformer: appends (not overwrites) all  -->
                <!-- META-INF/services/* files across JARs — critical for Lucene SPI -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

</project>
